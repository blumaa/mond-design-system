{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dsbridge-hook\" session-start",
            "timeout": 20,
            "statusMessage": "Reading the design system"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dsbridge-hook\" pre-tool-use",
            "timeout": 15,
            "statusMessage": "Checking against the design system"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dsbridge-hook\" stop",
            "timeout": 20,
            "statusMessage": "Comparing against the baseline"
          }
        ]
      }
    ]
  }
}
