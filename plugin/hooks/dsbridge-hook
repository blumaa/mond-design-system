#!/bin/sh
# The protocol carrier, and nothing else: find dsbridge, hand it the event, let
# it answer on stdout.
#
# Silent when the tool is not installed. A repo with no design system is one
# this plugin has nothing to say about, and a hook that errors on every write
# there is a hook someone removes — along with the checking, in the repos that
# did want it.
#
# Order: an explicit DSBRIDGE_BIN, then the copy this repo installed, then
# whatever is on PATH. The installed copy wins over PATH because the rules a
# repo is judged by are the ones it pinned, not the ones the machine happens
# to have.

event="$1"
[ -n "$event" ] || exit 0

if [ -n "$DSBRIDGE_BIN" ] && [ -x "$DSBRIDGE_BIN" ]; then
  exec "$DSBRIDGE_BIN" hook "$event"
fi

dir="${CLAUDE_PROJECT_DIR:-$PWD}"
while [ -n "$dir" ] && [ "$dir" != "/" ]; do
  if [ -x "$dir/node_modules/.bin/dsbridge" ]; then
    exec "$dir/node_modules/.bin/dsbridge" hook "$event"
  fi
  dir=$(dirname "$dir")
done

if command -v dsbridge >/dev/null 2>&1; then
  exec dsbridge hook "$event"
fi

exit 0
