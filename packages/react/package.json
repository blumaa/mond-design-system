{
  "name": "@mond-design-system/react",
  "version": "1.1.0",
  "description": "Mond Design System \u2014 React component library. Self-styled, brand-agnostic, WCAG 2.2 AA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blumaa/mond-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/blumaa/mond-design-system#readme",
  "bugs": {
    "url": "https://github.com/blumaa/mond-design-system/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "css-variables",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "true",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@mond-design-system/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "postcss-modules": "^9.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
