{
  "name": "ds-bridge",
  "version": "0.0.0",
  "description": "Design system conformance. Introspect the token graph, check an app against the system's rules, measure what it would take to adopt them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blumaa/mond-design-system.git",
    "directory": "packages/ds-bridge"
  },
  "type": "module",
  "bin": { "dsbridge": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "RULES.md", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "true",
    "clean": "rm -rf dist",
    "rules": "node dist/cli.js rules --markdown > RULES.md"
  },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "^5.9.3" }
}
