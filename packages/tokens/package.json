{
  "name": "@mond-design-system/tokens",
  "version": "3.1.1",
  "description": "Mond Design System \u2014 design tokens. CSS custom properties: core scales, semantic contract with neutral defaults (light + dark), brand template for consuming apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blumaa/mond-design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/blumaa/mond-design-system#readme",
  "bugs": {
    "url": "https://github.com/blumaa/mond-design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "design-system",
    "theming",
    "dark-mode"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./base.css": "./src/base.css",
    "./semantic.css": "./src/semantic.css",
    "./core/*.css": "./src/core/*.css",
    "./brand-template.css": "./src/brand-template.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "true",
    "typecheck": "tsc --noEmit",
    "lint": "true",
    "clean": "true"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
